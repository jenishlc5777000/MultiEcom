# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (replica set required for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/clay-and-glaze?retryWrites=true&w=majority

# Auth.js  (generate with: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Clay & Glaze <hello@yourdomain.com>"

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Image storage can also be set in Admin → Integrations (Cloudinary, S3/R2/Spaces, Vercel Blob).
# Vercel Blob (public store): added automatically when the store is connected to the Vercel project.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Extra image hosts for a custom CDN/domain in front of a bucket (comma-separated):
IMAGE_HOSTS=

# Cron (expire unpaid orders)
CRON_SECRET=

# Dev-only demo accounts (ignored in production)
DEMO_LOGIN=false
DEMO_PASSWORD=demo1234
