# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (replica set required for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/clay-and-glaze?retryWrites=true&w=majority

# Auth.js  (generate with: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Clay & Glaze <hello@yourdomain.com>"

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron (expire unpaid orders)
CRON_SECRET=

# Dev-only demo accounts (ignored in production)
DEMO_LOGIN=false
DEMO_PASSWORD=demo1234
